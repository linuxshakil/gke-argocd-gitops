#############################################################
# Terraform (bootstrap/)
#############################################################
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

